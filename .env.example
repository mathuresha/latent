# Copy this file to .env and set your site's public address (no trailing slash).
SITE_URL=https://playlatent.com

# Usage analytics (see src/core/analytics.js). The Web Analytics site token is public, so it is safe here.
# Cloudflare > Analytics & Logs > Web Analytics > your site > Manage site > JS snippet: the "token" value.
CF_WEB_ANALYTICS_TOKEN=
# Set to off to turn off all analytics (page views and event counts).
ANALYTICS=on

# Only for `npm run stats` on your own computer. Never commit these, and keep them out of .env.example.
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
